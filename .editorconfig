root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt reads this file directly. When .editorconfig is present it takes
# precedence over shfmt's command-line flags, so this is the single source of
# truth for shell formatting — keep it in sync with nothing else.
[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = false
space_redirects = false

[*.{json,jsonc,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false
