font-family = __GHOSTTY_FONT__
font-size = __GHOSTTY_FONT_SIZE__

# Ghostty ships Catppuccin and other popular themes built-in.
theme = __GHOSTTY_THEME__

# Cursor styling
cursor-color = __GHOSTTY_CURSOR_COLOR__

background-opacity = __GHOSTTY_OPACITY__
background-blur = __GHOSTTY_BLUR__
macos-titlebar-style = __GHOSTTY_TITLEBAR__
window-padding-x = 15
window-padding-y = 15
adjust-cell-height = 20%

copy-on-select = clipboard
window-save-state = always
confirm-close-surface = false

cursor-style = bar
cursor-style-blink = true
