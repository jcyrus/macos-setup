font-family = 0xProto Nerd Font Mono
font-size = 12

# Ghostty ships Catppuccin as a built-in theme, so there is no need to spell
# out the palette here. Run `ghostty +list-themes` to see the others.
theme = Catppuccin Mocha

# Mauve cursor, overriding the theme default.
cursor-color = #cba6f7

background-opacity = 0.88
background-blur = 20
macos-titlebar-style = hidden
window-padding-x = 15
window-padding-y = 15
adjust-cell-height = 20%

copy-on-select = clipboard
window-save-state = always
confirm-close-surface = false

cursor-style = bar
cursor-style-blink = true